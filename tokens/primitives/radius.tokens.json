{
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "{spacing.0}"
    },
    "xxs": {
      "$type": "dimension",
      "$value": "{spacing.0_5}"
    },
    "xs": {
      "$type": "dimension",
      "$value": "{spacing.1}"
    },
    "sm": {
      "$type": "dimension",
      "$value": "{spacing.1_5}"
    },
    "default": {
      "$type": "dimension",
      "$value": "{spacing.2}",
      "$description": "Its own rung on the scale (8px, the base grid unit) — not an alias for sm or md. Default radius for ordinary controls (buttons, inputs, cards) unless a component calls for a named size explicitly."
    },
    "md": {
      "$type": "dimension",
      "$value": "{spacing.3}"
    },
    "lg": {
      "$type": "dimension",
      "$value": "{spacing.4}"
    },
    "xl": {
      "$type": "dimension",
      "$value": "{spacing.6}"
    },
    "full": {
      "$type": "dimension",
      "$value": "{spacing.max}"
    }
  }
}