        "letterSpacing": "{tracking.normal}"
      },
      "$extensions": {
        "turbo.sportsbook/text": {
          "textDecoration": "underline"
        }
      }
    },
    "link-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.normal}",
        "fontSize": "{size.base}",
