    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.bold}",
        "fontSize": "{size.sm}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.wide}"
      },
      "$extensions": {
        "turbo.sportsbook/text": {
          "textTransform": "uppercase"
        }
      }
    },
    "label-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.bold}",
        "fontSize": "{size.base}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.wide}"
      },
      "$extensions": {
        "turbo.sportsbook/text": {
          "textTransform": "uppercase"
        }
      }
    },
    "$description": "Composite styles over the typography primitives. Two fixes vs. the Figma source: body-lg now uses size.lg (18px) — the source labeled it size.md (16px), duplicating body-md, inconsistent with every other row where the style name matches its size name (confirmed as a Figma slip, fixed here). title-xl/2xl/3xl use leading.tight (1.2) instead of leading.normal (1.4) — at 20-30px bold, 140% line-height reads as too much air for a single-line title; tightening as size grows is standard practice (Stripe/Linear/Vercel all do this). label-sm/base use tracking.wide instead of tracking.normal for the same reason (all-caps needs positive tracking to not look cramped)."
  }
}