        "fontSize": "{size.xs}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.normal}"
      }
    },
    "heading-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.semibold}",
        "fontSize": "{size.sm}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.normal}"
      }
    },
    "heading-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.semibold}",
        "fontSize": "{size.base}",
        "lineHeight": "{leading.normal}",
