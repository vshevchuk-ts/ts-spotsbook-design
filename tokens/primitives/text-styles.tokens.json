        "fontWeight": "{weight.normal}",
        "fontSize": "{size.xs}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.normal}"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{family.sans}",
        "fontWeight": "{weight.normal}",
        "fontSize": "{size.sm}",
        "lineHeight": "{leading.normal}",
        "letterSpacing": "{tracking.normal}"
      }
    },
    "body-base": {
      "$type": "typography",
      "$value": {
