{
  "component": {
    "select": {
      "$description": "Closed dropdown trigger — same box model as component.input: one fill (surface-0 page background + a surface-6 hairline border), lifting to a surface-4 filled look on hover. base/lg float a 10px label above the 16px selected value; sm has no floating label (shows the value single-line). Always shows a trailing chevron that flips to point up when active (the menu is open). The open menu/listbox itself is out of scope; this documents the trigger.",
      "radius": { "$type": "dimension", "$value": "{radius.default}" },
      "size": {
        "sm": {
          "height": { "$type": "dimension", "$value": "{spacing.8}" },
          "paddingX": { "$type": "dimension", "$value": "{spacing.2}" },
          "gap": { "$type": "dimension", "$value": "{spacing.2}" },
          "iconSize": { "$type": "dimension", "$value": "{spacing.4}" },
          "value": {
            "$type": "typography",
            "$value": { "fontFamily": "{family.sans}", "fontWeight": "{weight.normal}", "fontSize": "{size.md}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.normal}" }
          }
        },
        "base": {
          "height": { "$type": "dimension", "$value": "{spacing.10}" },
          "paddingX": { "$type": "dimension", "$value": "{spacing.3}" },
          "gap": { "$type": "dimension", "$value": "{spacing.2}" },
          "iconSize": { "$type": "dimension", "$value": "{spacing.5}" },
          "labelGap": { "$type": "dimension", "$value": "{spacing.0}" },
          "value": {
            "$type": "typography",
            "$value": { "fontFamily": "{family.sans}", "fontWeight": "{weight.normal}", "fontSize": "{size.md}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.normal}" }
          },
          "label": {
            "$type": "typography",
            "$value": { "fontFamily": "{family.sans}", "fontWeight": "{weight.normal}", "fontSize": "{size.xs}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.normal}" }
          }
        },
        "lg": {
          "height": { "$type": "dimension", "$value": "{spacing.12}" },
          "paddingX": { "$type": "dimension", "$value": "{spacing.4}" },
          "gap": { "$type": "dimension", "$value": "{spacing.2}" },
          "iconSize": { "$type": "dimension", "$value": "{spacing.6}" },
          "labelGap": { "$type": "dimension", "$value": "{spacing.1}" },
          "value": {
            "$type": "typography",
            "$value": { "fontFamily": "{family.sans}", "fontWeight": "{weight.normal}", "fontSize": "{size.md}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.normal}" }
          },
          "label": {
            "$type": "typography",
            "$value": { "fontFamily": "{family.sans}", "fontWeight": "{weight.normal}", "fontSize": "{size.xs}", "lineHeight": "{leading.tight}", "letterSpacing": "{tracking.normal}" }
          }
        },
        "$description": "Identical to component.input.size — same reasoning, see that token's own $description. iconSize drives the chevron."
      },
      "state": {
        "default": {
          "$description": "Empty, not focused. surface.page (surface-0) fill + outline.strong (surface-6) hairline border, grey placeholder, grey chevron pointing down.",
          "bg": { "$type": "color", "$value": "{surface.page}" },
          "border": { "$type": "color", "$value": "{outline.strong}" },
          "placeholder": { "$type": "color", "$value": "{text.secondary}" },
          "value": { "$type": "color", "$value": "{text.default}" },
          "chevron": { "$type": "color", "$value": "{icon.default}" }
        },
        "hover": {
          "$description": "Fills to the raised surface (surface-4) with the border blended in — the trigger lifts into a solid filled look, same move as input.state.hover.",
          "bg": { "$type": "color", "$value": "{surface.raised}" },
          "border": { "$type": "color", "$value": "{surface.raised}" }
        },
        "active": {
          "$description": "The menu is open. Fill stays surface-0; the border turns the active accent (outline.active) and the chevron flips to point up (still grey — the flip, not a colour change, signals open). The floating label stays grey. Distinct from 'focused', the keyboard-focus ring.",
          "border": { "$type": "color", "$value": "{outline.active}" }
        },
        "focused": {
          "ringColor": { "$type": "color", "$value": "{outline.accent}" },
          "ringWidth": { "$type": "dimension", "$value": "{spacing.1}" },
          "ringOffset": { "$type": "dimension", "$value": "{spacing.0_5}" },
          "$description": "Keyboard focus (:focus-visible) on the closed trigger — the active border plus an additive accent ring, the same focus indicator used on Button/Input/etc. The chevron stays down (the menu isn't open yet)."
        },
        "populated": {
          "$description": "Has a chosen value, not focused — label stays floated, colours revert to default.",
          "label": { "$type": "color", "$value": "{text.secondary}" }
        },
        "disabled": {
          "bg": { "$type": "color", "$value": "{surface.disabled}" },
          "border": { "$type": "color", "$value": "{outline.default}" },
          "placeholder": { "$type": "color", "$value": "{text.disabled}" },
          "value": { "$type": "color", "$value": "{text.disabled}" },
          "chevron": { "$type": "color", "$value": "{icon.disabled}" },
          "label": { "$type": "color", "$value": "{text.disabled}" }
        },
        "error": {
          "border": { "$type": "color", "$value": "{outline.negative}" },
          "text": { "$type": "color", "$value": "{text.negative}" },
          "$description": "Red border on the trigger (outline.negative) plus a red helper/error line below it (text.negative) — e.g. a required field left unselected."
        }
      }
    }
  }
}
